POSTGRES_PASSWORD=inko_admin_dev_only
CATALOG_DB_PASSWORD=inko_catalogo_dev_only
USERS_DB_PASSWORD=inko_usuarios_dev_only
CIRCULATION_DB_PASSWORD=inko_circulacao_dev_only
POSTGRES_PORT=5432

# Conta inicial de operador (SDD-002). Criada uma única vez, só se as duas
# variáveis estiverem definidas; senha com no mínimo 12 caracteres. Nunca
# commite valores reais: defina-os apenas no seu .env local.
INKO_BOOTSTRAP_ADMIN_EMAIL=
INKO_BOOTSTRAP_ADMIN_PASSWORD=
INKO_BOOTSTRAP_ADMIN_NAME=Administrador INKO
INKO_SESSION_TTL=8h
# Vazio = Secure automático (HTTPS). Use true atrás de proxy TLS.
INKO_COOKIE_SECURE=
